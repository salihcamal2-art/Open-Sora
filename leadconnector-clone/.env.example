# ---- server ----
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used in booking / payment / review links sent to customers)
PUBLIC_URL=http://localhost:4000
# Where the SQLite database is stored
DATA_DIR=./data
# Set to false to start with an empty database (no demo data)
SEED=true

# ---- real SMS / WhatsApp (Twilio) — leave empty to simulate ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ---- real email (SendGrid) — leave empty to simulate ----
SENDGRID_API_KEY=
EMAIL_FROM=

# ---- branding ----
APP_NAME=LeadConnector

# ---- Conversation AI (reply suggestions, summaries, rewriting) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- real card payments (Stripe Checkout) — leave empty to simulate ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Web Push (optional: generated automatically and stored in the DB if empty) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
